APP_NAME="Naturalenha"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://naturalenha.com

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# Para usar MySQL (disponível na Hostinger em hPanel > Bases de dados):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=contacto@naturalenha.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contacto@naturalenha.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google Merchant API (products/v1) — see GOOGLE_MERCHANT_API.md
# Prefer OAuth refresh token. Service-account JSON is an alternative.
# APP_URL must be https://naturalenha.com when syncing (not localhost).
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_DATA_SOURCE_ID=
GOOGLE_MERCHANT_DATA_SOURCE_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional fallback: path to service-account JSON (gitignored under storage/app/google/)
GOOGLE_MERCHANT_CREDENTIALS=
GOOGLE_MERCHANT_LANGUAGE=pt
GOOGLE_MERCHANT_FEED_LABEL=PT
GOOGLE_MERCHANT_COUNTRY=PT
GOOGLE_MERCHANT_EXCLUDED_COUNTRIES=ES,FR,DE,IT,GB,US,AD,BE
GOOGLE_MERCHANT_QUEUE=default

